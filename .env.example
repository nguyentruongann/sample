# PostgreSQL runs OUTSIDE Docker. These URLs are used INSIDE app containers.
# For a remote DB server, replace host.docker.internal with its DNS/IP.
# Percent-encode reserved characters in passwords embedded in URLs.
DATABASE_URL=postgresql://demand_user:CHANGE_ME_WITH_A_STRONG_PASSWORD@host.docker.internal:5432/demand_db
AIRFLOW_METADATA_URL=postgresql+psycopg2://airflow:CHANGE_ME_AIRFLOW_DB_PASSWORD@host.docker.internal:5432/airflow
# First run only, when demand_db / airflow or their roles do not exist yet.
# Use an EXISTING admin role with CREATEROLE + CREATEDB rights; do not use pgAdmin credentials unless they belong to PostgreSQL itself.
# Example: postgresql://postgres:URL_ENCODED_ADMIN_PASSWORD@host.docker.internal:5432/postgres
# Leave blank if both roles/databases already exist and their passwords match the URLs above.
POSTGRES_ADMIN_URL=
POSTGRES_SCHEMA=public
POSTGRES_TABLE=fake_demand_10min
PREDICTIONS_TABLE=demand_predictions

SEED=20260916
LOCAL_TIMEZONE=Asia/Ho_Chi_Minh
TRAIN_RATIO=0.80
TEST_START=2026-08-15T09:40:00+07:00
VALIDATION_DAYS=30
ROLLING_TEST_DAYS=30
TRAIN_HISTORY_DAYS=90
# Locked leaves/trees from final.ipynb. notebook_search repeats the original search.
TRAINING_STRATEGY=locked
FRESH_BUCKETS_CLOSED_AT_T=true
# Search and final fitting use ALL rows; legacy SEARCH_*_ROWS are ignored.
SEARCH_ESTIMATORS=800
# Reserve CPU for 10-minute inference while weekly training runs.
TRAIN_N_JOBS=4

# Must be empty for the final notebook contract (no training row sampling).
MAX_TRAIN_ROWS=
MODEL_NAMES=lightgbm
HORIZONS=10,30,60
PREDICTION_HISTORY_DAYS=8
MIN_TRAIN_ROWS=100000

# Docker services
API_PORT=8000
AIRFLOW_PORT=8080
AIRFLOW_VERSION=3.3.2
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=GENERATE_WITH_FERNET_GENERATE_KEY
AIRFLOW_API_JWT_SECRET=GENERATE_RANDOM_HEX_SECRET
