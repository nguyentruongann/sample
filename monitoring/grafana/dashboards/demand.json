{
  "uid": "demand-monitoring",
  "title": "Demand · Feature, Performance, Prediction Distribution",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "1 · Feature monitoring",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Feature warning",
      "type": "timeseries",
      "description": "Performance values are last evaluated window snapshots at scrape time; see port 8001 for exact window history.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "demand-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "demand_feature_warning",
          "legendFormat": "{{travel_mode}} H{{horizon_minutes}} {{feature}} {{model_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
